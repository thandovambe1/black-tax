# ─────────────────────────────────────────────────────────────────────────────
# BLACK TAX — Environment Variables
# Copy these into: Vercel → Project → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — PostgreSQL connection string.
# Use a hosted Postgres provider (Neon, Supabase, or Vercel Postgres).
# Hosted databases require SSL; this is handled automatically.
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# REQUIRED — Public URL of the deployed site (no trailing slash).
# Used to build Yoco success/cancel redirect URLs.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# REQUIRED — Secret used to sign admin session cookies.
# Generate one with:  openssl rand -base64 32
ADMIN_SESSION_SECRET=change-me-to-a-long-random-string

# ── Yoco (accepting donations) ───────────────────────────────────────────────
# From https://portal.yoco.com → Sell Online → Payment Gateway
# Optional: the site runs without these; live card payments stay disabled.
YOCO_SECRET_KEY=
YOCO_WEBHOOK_SECRET=

# ── FNB (paying out funds to service providers) ──────────────────────────────
# Optional: payouts fall back to FNB batch-file export when unset.
FNB_ACCOUNT_NAME=
FNB_ACCOUNT_NUMBER=
FNB_BRANCH_CODE=
FNB_API_BASE_URL=
FNB_API_KEY=
