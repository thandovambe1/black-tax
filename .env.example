# ─────────────────────────────────────────────────────────────────────────────
# BLACK TAX — PRODUCTION FINANCIAL SYSTEM ENVIRONMENT VARIABLES
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. CORE DATABASE (REQUIRED) ─────────────────────────────────────────────
# PostgreSQL connection string for production database (Neon, Supabase, Vercel Postgres).
# Must include sslmode=require for hosted production databases.
DATABASE_URL=postgresql://user:password@host.neon.tech/blacktax_db?sslmode=require

# ── 2. SITE CONFIGURATION (REQUIRED) ────────────────────────────────────────
# Canonical public URL of the deployed website (no trailing slash).
# Used to construct authoritative Yoco redirect URLs and webhook callbacks.
NEXT_PUBLIC_SITE_URL=https://blacktax.org.za

# ── 3. ADMIN AUTHENTICATION (REQUIRED) ──────────────────────────────────────
# High-entropy random secret key used to HMAC-sign admin session cookies.
# Generate with: openssl rand -base64 32
ADMIN_SESSION_SECRET=your-32-byte-base64-random-session-secret

# ── 4. YOCO CARD PAYMENT GATEWAY (ONLINE DONATIONS) ──────────────────────────
# Secret API key from Yoco Business Portal (portal.yoco.com -> Sell Online -> Payment Gateway).
# Use sk_test_... for sandbox testing and sk_live_... for production.
YOCO_SECRET_KEY=sk_test_your_yoco_secret_key
# Secret used to verify Svix/HMAC-SHA256 signatures on incoming Yoco payment webhooks.
# Format: whsec_...
YOCO_WEBHOOK_SECRET=whsec_your_yoco_webhook_secret

# ── 5. SOUTH AFRICAN DEBIT ORDER BUREAU (DEBICHECK & REGISTERED MANDATES) ───
# Regulated intermediary partner service key (e.g. Netcash / Stitch / BankservAfrica).
# Set DEBIT_ORDER_MODE to "test" for safe sandbox simulation without touching bank accounts.
DEBIT_ORDER_MODE=test
DEBIT_ORDER_SERVICE_KEY=your-debit-order-bureau-service-key
DEBIT_ORDER_API_URL=https://ws.netcash.co.za/DebiCheck/DebiCheckService.svc
DEBIT_ORDER_WEBHOOK_SECRET=your-debit-order-webhook-secret-key

# ── 6. FNB SERVICE PROVIDER PAYOUTS ──────────────────────────────────────────
# Registered FNB commercial account details used for funds disbursement reconciliation.
FNB_ACCOUNT_NAME=Black Tax Non-Profit Organisation
FNB_ACCOUNT_NUMBER=62000000000
FNB_BRANCH_CODE=250655
# Optional: FNB Commercial API credentials for automated direct host-to-host API payouts.
# When omitted, the system generates downloadable FNB-compliant ACB/EFT batch CSV files.
FNB_API_BASE_URL=https://api.fnb.co.za/commercial/v1
FNB_API_KEY=your-fnb-commercial-api-key
